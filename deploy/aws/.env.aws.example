# COPIAR a .env.aws, ignorado por Git. Nunca reutilizar claves de ejemplo.
# Tres bases/usuarios en UNA instancia RDS PostgreSQL; no ejecutar como superusuario.
RDS_HOST=REEMPLAZAR_ENDPOINT_RDS
CATALOG_DB_PASSWORD=REEMPLAZAR
SHIPMENTS_DB_PASSWORD=REEMPLAZAR
MESSAGING_DB_PASSWORD=REEMPLAZAR
RABBITMQ_PASSWORD=REEMPLAZAR
RABBITMQ_ERLANG_COOKIE=REEMPLAZAR
# Generar claves hexadecimales con openssl rand -hex 24. Sin $, comillas ni comentarios.
AZURE_TENANT_ID=
AZURE_SPA_CLIENT_ID=
AZURE_API_CLIENT_ID=
AZURE_OPERATOR_SCOPE=operator.access
# Copiar identificadores PUBLICOS del Cognito existente; no crear otro user pool.
COGNITO_ISSUER_URI=
COGNITO_CLIENT_ID=
BFF_BIND_ADDRESS=127.0.0.1
