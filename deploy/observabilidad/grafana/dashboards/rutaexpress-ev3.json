{
  "uid": "rutaexpress-ev3",
  "title": "RutaExpress EV3",
  "tags": [
    "rutaexpress",
    "ev3"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "schemaVersion": 41,
  "version": 1,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Envíos por estado",
      "datasource": {
        "type": "prometheus",
        "uid": "rutaexpress-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 8
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rutaexpress_report_shipments",
          "legendFormat": "{{status}}",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Eventos procesados por Reportes",
      "datasource": {
        "type": "prometheus",
        "uid": "rutaexpress-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rutaexpress_report_events_total",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Estado de Reportes",
      "datasource": {
        "type": "prometheus",
        "uid": "rutaexpress-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 8,
        "w": 8,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Sin conexión",
                  "color": "red"
                },
                "1": {
                  "text": "Disponible",
                  "color": "green"
                }
              }
            }
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"rutaexpress-reportes\"}",
          "instant": true
        }
      ]
    }
  ]
}
